{
  "opencollection": "1.0.0",
  "info": {
    "name": "Couchbase Analytics Service REST Allowed CIDRs Logging API",
    "version": "7.6"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logging",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Eventing Function application log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8095/api/v1/functions/:functionName/applog",
            "params": [
              {
                "name": "functionName",
                "value": "",
                "type": "path",
                "description": "The name of the Eventing Function"
              },
              {
                "name": "aggregate",
                "value": "",
                "type": "query",
                "description": "Whether to aggregate logs from all nodes"
              }
            ]
          },
          "docs": "Returns the most recent application log messages generated by the specified Eventing Function via the log() function in handler code."
        }
      ]
    }
  ],
  "bundled": true
}