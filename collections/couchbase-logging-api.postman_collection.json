      "item": [
        {
          "id": "f3b950e8-2789-46e7-a34a-1493ddeb869a",
          "name": "Get Eventing Function application log",
          "request": {
            "name": "Get Eventing Function application log",
            "description": {
              "content": "Returns the most recent application log messages generated by the specified Eventing Function via the log() function in handler code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "functions",
                ":functionName",
                "applog"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "aggregate",
                  "value": "true",
                  "description": "Whether to aggregate logs from all nodes"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "functionName",
                  "description": "(Required) The name of the Eventing Function"
                }
              ]
            },
            "header": [
