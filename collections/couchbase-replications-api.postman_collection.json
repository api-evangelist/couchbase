{
  "info": {
    "_postman_id": "7752d9b8-e975-4a67-9f0e-ae10009dbd56",
    "name": "Couchbase XDCR REST Replications API",
    "description": "The Couchbase XDCR (Cross Data Center Replication) REST API enables configuration and management of data replication between Couchbase clusters across different data centers. It provides endpoints for creating replication references, configuring replication streams, monitoring replication statistics, and managing replication settings. XDCR supports both unidirectional and bidirectional replication for high availability and disaster recovery scenarios.\n\nContact Support:\n Name: Couchbase Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T19:58:40.000Z",
    "updatedAt": "2026-10-21T19:58:40.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-7752d9b8-e975-4a67-9f0e-ae10009dbd56"
  },
