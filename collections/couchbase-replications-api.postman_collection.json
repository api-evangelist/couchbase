                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) Name of the source bucket",
                      "key": "fromBucket",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Name of the remote cluster reference",
                      "key": "toCluster",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Name of the target bucket on the remote cluster",
                      "key": "toBucket",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Type of replication",
                      "key": "replicationType",
                      "value": "continuous"
                    },
                    {
                      "description": "Regular expression filter for document IDs",
                      "key": "filterExpression",
                      "value": "<string>"
                    },
                    {
                      "description": "Compression type for replication data",
                      "key": "compressionType",
                      "value": "None"
                    },
                    {
                      "description": "Replication priority",
