          "name": "Trigger an immediate backup",
          "request": {
            "name": "Trigger an immediate backup",
            "description": {
              "content": "Triggers an immediate one-off backup for the specified active repository, independent of the scheduled backup plan.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "cluster",
                "self",
                "repository",
                "active",
                ":repositoryId",
                "backup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) The name of the backup repository"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_backup\": \"<boolean>\"\n}",
