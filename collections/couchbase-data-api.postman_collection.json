          "id": "f599adbf-25d6-4752-9352-6d76aa546be7",
          "name": "Restore from a backup",
          "request": {
            "name": "Restore from a backup",
            "description": {
              "content": "Initiates a restore operation from the specified backup repository, allowing you to restore specific buckets or all data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "cluster",
                "self",
                "repository",
                "active",
                ":repositoryId",
                "restore"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) The name of the backup repository"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"<string>\",\n  \"start\": \"<dateTime>\",\n  \"end\": \"<dateTime>\",\n  \"include_buckets\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"exclude_buckets\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"map_data\": \"<string>\",\n  \"auto_create_buckets\": \"<boolean>\",\n  \"auto_remove_collections\": \"<boolean>\"\n}",
