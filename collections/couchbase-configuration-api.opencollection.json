{
  "opencollection": "1.0.0",
  "info": {
    "name": "Couchbase Analytics Service REST Allowed CIDRs Configuration API",
    "version": "7.6"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Eventing Service configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8095/api/v1/config"
          },
          "docs": "Returns the current configuration settings for the Eventing Service."
        },
        {
          "info": {
            "name": "Update Eventing Service configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://localhost:8095/api/v1/config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the configuration settings for the Eventing Service."
        }
      ]
    }
  ],
  "bundled": true
}