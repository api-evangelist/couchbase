  "info": {
    "_postman_id": "29d39d2e-265d-40cb-9815-386307ef719e",
    "name": "Couchbase Search Service REST Search Monitoring API",
    "description": "The Couchbase Search Service REST API allows developers to create, manage, and query Full Text Indexes on Couchbase Server. It supports full-text search queries with features like fuzzy matching, faceted search, highlighting, and geospatial queries. The API provides endpoints for index definition, index management, and executing search queries across JSON documents stored in Couchbase buckets.\n\nContact Support:\n Name: Couchbase Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T19:58:57.000Z",
