{
  "opencollection": "1.0.0",
  "info": {
    "name": "Couchbase Analytics Service REST Allowed CIDRs Logs API",
    "version": "7.6"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get diagnostic information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8095/diag"
          },
          "docs": "Returns diagnostic information for the cluster including logs and system statistics useful for troubleshooting."
        },
        {
          "info": {
            "name": "Start log collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://localhost:8095/controller/startLogsCollection",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "nodes",
                  "value": ""
                },
                {
                  "name": "logRedactionLevel",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Initiates the collection of diagnostic logs across cluster nodes for analysis and troubleshooting."
        }
      ]
    }
  ],
  "bundled": true
}