  "info": {
    "_postman_id": "83fab30b-5485-422b-b266-6a5c38d5f829",
    "name": "Couchbase Analytics Service REST Allowed CIDRs Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Couchbase Analytics Service REST API provides access to the Analytics service for running complex analytical queries on operational data without impacting performance of key-value operations. It supports SQL++ queries for analytics, management of links to external data sources, and configuration of user-defined libraries. The service enables real-time analytics on JSON data alongside transactional workloads.\n\nContact Support:\n Name: Couchbase Support",
      "type": "text/plain"
    }
  }
