  "info": {
    "_postman_id": "ae382de2-9352-4c3c-902f-39f799326809",
    "name": "Couchbase Query Service REST Query Settings API",
    "description": "The Couchbase Query Service REST API enables developers to execute SQL++ (formerly N1QL) queries against Couchbase Server and manage query service settings. It supports ad-hoc queries, prepared statements, and request-level parameter configuration. The API provides endpoints for query execution, monitoring active requests, and managing query service configuration across cluster nodes.\n\nContact Support:\n Name: Couchbase Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T19:58:27.000Z",
    "updatedAt": "2026-10-21T19:58:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ae382de2-9352-4c3c-902f-39f799326809"
  },
