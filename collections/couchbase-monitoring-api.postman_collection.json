    "_postman_id": "1493f13f-7164-4c9a-a808-2635daae9062",
    "name": "Couchbase Sync Gateway Admin REST Monitoring API",
    "description": "The Couchbase Sync Gateway Admin REST API provides administrative endpoints for configuring and managing Sync Gateway instances. It supports database management, user and role administration, sync function configuration, and replication setup. The API is intended for server-side administration and is typically bound to localhost for security, enabling full control over Sync Gateway behavior, access control policies, and data synchronization rules.\n\nContact Support:\n Name: Couchbase Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
