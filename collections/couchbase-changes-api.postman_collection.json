  "item": [
    {
      "id": "3e8daa75-dfab-47d5-b311-740df75efa33",
      "name": "Changes",
      "description": {
        "content": "Endpoints for monitoring document changes and subscribing to change feeds.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b57579c4-6199-497f-9105-67c534133d0f",
          "name": "Get changes feed",
          "request": {
            "name": "Get changes feed",
            "description": {
              "content": "Returns a list of changes made to documents in the database in sequence order. Supports long-polling, continuous, and one-shot modes for real-time synchronization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":db",
                "_changes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<string>",
                  "description": "Sequence number to start from"
                },
                {
                  "disabled": false,
                  "key": "feed",
                  "value": "<string>",
                  "description": "Type of changes feed"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter function to apply"
                },
                {
                  "disabled": false,
                  "key": "channels",
                  "value": "<string>",
                  "description": "Comma-separated list of channel names to filter by"
                },
                {
                  "disabled": false,
                  "key": "include_docs",
                  "value": "<boolean>",
                  "description": "Whether to include document bodies"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of changes to return"
                },
                {
                  "disabled": false,
                  "key": "heartbeat",
                  "value": "<integer>",
                  "description": "Heartbeat interval in milliseconds for continuous feed"
                },
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "<integer>",
                  "description": "Timeout in milliseconds for longpoll feed"
                },
                {
                  "disabled": false,
                  "key": "style",
                  "value": "<string>",
                  "description": "Whether to return all leaf revisions"
                },
                {
                  "disabled": false,
                  "key": "active_only",
                  "value": "<boolean>",
                  "description": "Whether to exclude deleted documents"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "db",
                  "description": "(Required) The name of the database (keyspace)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
