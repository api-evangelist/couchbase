                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/:db/_changes?since=<string>&feed=longpoll&filter=sync_gateway/bychannel&channels=<string>&include_docs=<boolean>&limit=<integer>&heartbeat=<integer>&timeout=<integer>&style=main_only&active_only=<boolean>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":db",
                    "_changes"
                  ],
                  "query": [
                    {
                      "description": "Sequence number to start from",
                      "key": "since",
                      "value": "<string>"
                    },
                    {
                      "description": "Type of changes feed",
                      "key": "feed",
                      "value": "longpoll"
                    },
                    {
                      "description": "Filter function to apply",
                      "key": "filter",
                      "value": "sync_gateway/bychannel"
                    },
                    {
                      "description": "Comma-separated list of channel names to filter by",
                      "key": "channels",
                      "value": "<string>"
                    },
                    {
                      "description": "Whether to include document bodies",
                      "key": "include_docs",
                      "value": "<boolean>"
                    },
                    {
                      "description": "Maximum number of changes to return",
                      "key": "limit",
                      "value": "<integer>"
                    },
                    {
                      "description": "Heartbeat interval in milliseconds for continuous feed",
                      "key": "heartbeat",
                      "value": "<integer>"
                    },
                    {
                      "description": "Timeout in milliseconds for longpoll feed",
                      "key": "timeout",
                      "value": "<integer>"
                    },
                    {
                      "description": "Whether to return all leaf revisions",
                      "key": "style",
                      "value": "main_only"
                    },
                    {
                      "description": "Whether to exclude deleted documents",
                      "key": "active_only",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "2c3eabdb-d38d-4014-b4e2-e0b517a128d5",
                      "key": "db",
                      "value": "<string>",
                      "description": "(Required) The name of the database (keyspace)"
                    }
                  ]
                },
                "description": "Returns a list of changes made to documents in the database in sequence order. Supports long-polling, continuous, and one-shot modes for real-time synchronization."
