{
  "opencollection": "1.0.0",
  "info": {
    "name": "Couchbase Analytics Service REST Allowed CIDRs Settings API",
    "version": "7.6"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Configure web settings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://localhost:8095/settings/web",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "port",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Configures the cluster web console settings including the admin username, password, and port."
        }
      ]
    }
  ],
  "bundled": true
}