        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloudapi.cloud.couchbase.com/v4/organizations"
          },
          "docs": "Returns the list of organizations the authenticated API key has access to."
