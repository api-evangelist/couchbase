        {
          "info": {
            "name": "Get organization details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloudapi.cloud.couchbase.com/v4/organizations/:organizationId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "The UUID of the organization"
              }
            ]
          },
          "docs": "Returns detailed information about a specific organization."
        }
      ]
    },
