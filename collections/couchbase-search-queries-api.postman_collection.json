          "name": "Query a search index",
          "request": {
            "name": "Query a search index",
            "description": {
              "content": "Executes a full-text search query against the specified index. Supports various query types including match, term, phrase, boolean, numeric range, date range, geospatial, and conjunction/disjunction queries. Results include relevance scores, highlighting, and faceted results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "index",
                ":indexName",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "indexName",
                  "description": "(Required) The name of the Full Text Search index"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
