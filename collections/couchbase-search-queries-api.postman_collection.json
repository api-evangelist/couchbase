              "mode": "raw",
              "raw": "{\n  \"query\": {\n    \"match\": \"<string>\",\n    \"field\": \"<string>\",\n    \"analyzer\": \"<string>\",\n    \"fuzziness\": \"<integer>\",\n    \"prefix_length\": \"<integer>\",\n    \"boost\": \"<number>\"\n  },\n  \"size\": 10,\n  \"from\": 0,\n  \"fields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"highlight\": {\n    \"style\": \"<string>\",\n    \"fields\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"facets\": {\n    \"key_0\": {\n      \"field\": \"<string>\",\n      \"size\": \"<integer>\"\n    }\n  },\n  \"sort\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"explain\": \"<boolean>\",\n  \"ctl\": {\n    \"timeout\": \"<integer>\",\n    \"consistency\": {\n      \"level\": \"<string>\"\n    }\n  }\n}",
